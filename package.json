{
  "name": "@cdt5058/json-render-uswds",
  "version": "0.2.0",
  "author": "ctrimm",
  "description": "U.S. Web Design System (USWDS) component library for @json-render/core. JSON becomes accessible, government-compliant React components.",
  "license": "Apache-2.0",
  "keywords": [
    "json",
    "ui",
    "react",
    "uswds",
    "us-web-design-system",
    "government",
    "accessibility",
    "ai",
    "generative-ui",
    "llm",
    "renderer",
    "components",
    "federal"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ctrimm/json-render-uswds.git"
  },
  "homepage": "https://github.com/ctrimm/json-render-uswds#readme",
  "bugs": {
    "url": "https://github.com/ctrimm/json-render-uswds/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    },
    "./catalog": {
      "types": "./dist/catalog.d.ts",
      "import": "./dist/catalog.mjs",
      "require": "./dist/catalog.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "changeset": "changeset",
    "ci:version": "changeset version",
    "ci:publish": "npm run build && changeset publish"
  },
  "dependencies": {
    "@json-render/core": "^0.16.0",
    "@json-render/react": "^0.16.0"
  },
  "devDependencies": {
    "@changesets/cli": "^2.29.8",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.1",
    "@types/react": "^19.2.3",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "jsdom": "^27.4.0",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "tsup": "^8.0.2",
    "typescript": "^5.4.5",
    "vitest": "^4.0.17",
    "zod": "^4.3.6"
  },
  "peerDependencies": {
    "@uswds/uswds": "^3.8.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "zod": "^4.0.0"
  },
  "peerDependenciesMeta": {
    "@uswds/uswds": {
      "optional": true
    }
  },
  "engines": {
    "node": ">=22.14.0"
  }
}
