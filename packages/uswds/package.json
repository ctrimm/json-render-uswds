{
  "name": "@json-render/uswds",
  "version": "0.16.0",
  "author": "json-render contributors",
  "license": "Apache-2.0",
  "description": "U.S. Web Design System (USWDS) component library for @json-render/core. JSON becomes accessible, government-compliant React components.",
  "keywords": [
    "json",
    "ui",
    "react",
    "uswds",
    "us-web-design-system",
    "government",
    "accessibility",
    "ai",
    "generative-ui",
    "llm",
    "renderer",
    "streaming",
    "components",
    "federal"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ctrimm/json-render-uswds.git",
    "directory": "packages/uswds"
  },
  "homepage": "https://json-render.dev",
  "bugs": {
    "url": "https://github.com/ctrimm/json-render-uswds/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    },
    "./catalog": {
      "types": "./dist/catalog.d.ts",
      "import": "./dist/catalog.mjs",
      "require": "./dist/catalog.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "check-types": "tsc --noEmit",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@json-render/core": "workspace:*",
    "@json-render/react": "workspace:*"
  },
  "devDependencies": {
    "@internal/typescript-config": "workspace:*",
    "@types/react": "19.2.3",
    "tsup": "^8.0.2",
    "typescript": "^5.4.5",
    "zod": "^4.3.6"
  },
  "peerDependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "zod": "^4.0.0"
  },
  "peerDependenciesMeta": {
    "@uswds/uswds": {
      "optional": true
    }
  }
}
